<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application android:allowBackup="false" android:label="@string/ui_app_name" android:supportsRtl="true" android:theme="@style/Theme.NightSafety" tools:replace="android:allowBackup,android:label">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait" android:configChanges="fontScale">
            <!-- shortcut: API 36 large-screen opt-out; revisit before targeting API 37. -->
            <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NightSafety.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/ui_teal</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:buttonStyle">@style/UiButton</item>
    </style>
    <style name="Theme.NightSafety" parent="Theme.NightSafety.Base" />
    <style name="UiButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/ui_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/ui_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
    </style>
    <style name="UiPrimaryButton" parent="UiButton">
        <item name="android:background">@drawable/ui_primary_button</item>
        <item name="android:textColor">@color/ui_surface</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="UiInputButton" parent="UiButton">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="UiCard">
        <item name="android:background">@drawable/ui_card</item>
        <item name="android:padding">14dp</item>
    </style>
    <style name="UiSectionTitle" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/ui_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="UiBody" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="UiFilter" parent="android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/ui_teal</item>
        <item name="android:textColor">@color/ui_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="UiMetricValue" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/ui_teal</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:text">@string/ui_dash</item>
    </style>
</resources>

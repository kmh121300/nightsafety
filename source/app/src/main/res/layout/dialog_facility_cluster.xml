<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_card"
    android:backgroundTint="@color/ui_surface"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- 상단 헤더 (타이틀 + 시설 개수 배지) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cluster_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:text="이 위치의 안전시설"
            android:textColor="@color/ui_ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cluster_total_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ui_cluster_badge"
            android:backgroundTint="@color/ui_soft"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="@color/ui_teal"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/cluster_summary_subtitle"
        style="@style/UiBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ui_teal"
        android:textSize="13sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="@color/ui_line" />

    <!-- 시설 목록 영역 -->
    <LinearLayout
        android:id="@+id/cluster_group_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 닫기 버튼 -->
    <Button
        android:id="@+id/cluster_close"
        style="@style/UiPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/ui_teal"
        android:text="닫기"
        android:textColor="#0B1120"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>